<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Screen"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Content"
        android:gravity="center_vertical">

        <TextView
            style="@style/PageTitle"
            android:text="Grid Operator\nVerification" />

        <TextView
            style="@style/PageSubtitle"
            android:text="Enter or scan a reservation transaction code to finalize an approved energy transfer." />

        <LinearLayout style="@style/Panel">
            <EditText
                android:id="@+id/qrCode"
                style="@style/Input"
                android:hint="QR transaction code"
                android:inputType="textCapCharacters" />

            <Button
                android:id="@+id/finalizeButton"
                style="@style/PrimaryButton"
                android:text="Verify and Finalize Transfer" />

            <TextView
                android:id="@+id/result"
                style="@style/BodyText"
                android:layout_marginTop="14dp"
                android:text="Verification result will appear here." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
