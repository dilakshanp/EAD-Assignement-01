<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="214dp"
            android:background="@drawable/auth_hero_dark"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/logo_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:includeFontPadding="false"
                    android:text="Resolar"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Account settings"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="Update your profile details or request account deactivation."
                android:textColor="#D8EEE6"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Profile details"
                android:textColor="#092C23"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="NIC is used as your primary account key for booking and verification."
                android:textColor="#5F746C"
                android:textSize="14sp" />

            <EditText android:id="@+id/nic" style="@style/Input" android:layout_marginTop="22dp" android:hint="NIC" android:inputType="textCapCharacters" />
            <EditText android:id="@+id/fullName" style="@style/Input" android:hint="Full name" android:inputType="textPersonName" />
            <EditText android:id="@+id/phone" style="@style/Input" android:hint="Phone" android:inputType="phone" />
            <EditText android:id="@+id/email" style="@style/Input" android:hint="Email" android:inputType="textEmailAddress" />
            <EditText android:id="@+id/address" style="@style/Input" android:hint="Solar property address" android:inputType="textPostalAddress" />
            <EditText android:id="@+id/capacity" style="@style/Input" android:hint="Solar capacity kW" android:inputType="numberDecimal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Security"
                android:textColor="#092C23"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText android:id="@+id/registerPassword" style="@style/Input" android:hint="New password optional" android:inputType="textPassword" />
            <EditText android:id="@+id/confirmPassword" style="@style/Input" android:hint="Confirm new password" android:inputType="textPassword" />
            <Button android:id="@+id/saveButton" style="@style/PrimaryButton" android:text="Update profile"
            android:elevation="0dp"
            android:translationZ="0dp"
            android:stateListAnimator="@null" />
            <Button android:id="@+id/deactivateButton" style="@style/DangerButton" android:text="Request deactivation"
            android:elevation="0dp"
            android:translationZ="0dp"
            android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
